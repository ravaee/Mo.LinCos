# LinCos agent. install/server.sh installs it; see the README.

[Unit]
Description=LinCos monitoring agent
Documentation=https://github.com/ravaee/Mo.LinCos
After=network.target docker.service

[Service]
ExecStart=/usr/local/bin/lincos agent
Restart=on-failure
RestartSec=5

# Light by design: a soft cap for the Go runtime, a hard one from the kernel,
# and the lowest priority, so it never competes with what it watches
Environment=GOMEMLIMIT=32MiB
MemoryMax=64M
Nice=10
CPUWeight=20
IOSchedulingClass=idle

# It runs as root to see every process and container. The system itself
# (/usr, /boot, /etc) and home folders are read-only to it; data folders such
# as /var, /srv, /opt and other top-level folders stay writable, so files can
# be deleted or uploaded from a container's Files tab
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
